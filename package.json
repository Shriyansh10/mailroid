{
  "name": "trpc-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "dotenv -- turbo build",
    "dev": "dotenv -- turbo dev",
    "db:generate": "dotenv -- turbo db:generate",
    "db:migrate": "dotenv -- turbo db:migrate",
    "admin": "dotenv -e .env -v LOGGER_LEVEL=error -- tsx packages/scripts/src/cli.ts",
    "admin:verbose": "dotenv -e .env -- tsx packages/scripts/src/cli.ts",
    "admin:prod": "tsx packages/scripts/src/prod.ts",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test"
  },
  "devDependencies": {
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "turbo": "^2.11.11",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv-cli": "^11.1.0"
  },
  "pnpm": {
    "overrides": {
      "minimatch@>=3.0.0 <3.1.4": "^3.1.4",
      "minimatch@>=9.0.0 <9.0.7": "^9.0.7",
      "brace-expansion@>=1.0.0 <1.1.20": "^1.1.20",
      "brace-expansion@>=2.0.0 <2.1.6": "^2.1.6",
      "picomatch@>=2.0.0 <2.3.2": "^2.3.2",
      "path-to-regexp@>=8.0.0 <8.4.0": "^8.4.0",
      "lodash@>=4.0.0 <4.18.0": "^4.18.0",
      "js-yaml@>=3.0.0 <3.15.2": "^3.15.2",
      "nanoid@>=5.0.0 <5.1.16": "^5.1.16",
      "browserslist@>=4.0.0 <4.28.7": "^4.28.7",
      "source-map-js@>=1.0.0 <1.2.2": "^1.2.2",
      "h3@>=1.0.0 <1.15.6": "^1.15.6",
      "@grpc/grpc-js@>=1.14.0 <1.14.5": "^1.14.5",
      "@opentelemetry/propagator-jaeger@>=2.0.0 <2.9.0": "^2.9.0",
      "systeminformation@>=5.0.0 <5.33.16": "^5.33.16",
      "qs@>=6.0.0 <6.16.1": "^6.16.1",
      "yaml@>=2.0.0 <2.8.3": "^2.8.3",
      "protobufjs@>=7.0.0 <7.6.5": "^7.6.5",
      "@corsair-dev/gmail>jest": "link:./tools/no-jest",
      "@corsair-dev/googlecalendar>jest": "link:./tools/no-jest"
    }
  }
}
