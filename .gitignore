# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules
.pnp
.pnp.js

# Local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# Backups of .env made while switching credentials — these hold real secrets
# and the bare `.env` rule above does not match them.
.env.bak*
.env.backup*

# Testing
coverage

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist


# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dev.log

# Winston's file transport. Historically landed in four different places,
# because the path was CWD-relative and the log went wherever the process
# started. The path is pinned now; the glob stays deliberately broad.
logs/
**/logs/

# Scratch / ad-hoc scripts, not part of the product
packages/services/scratch/

# Misc
.DS_Store
*.pem

*.zip
chatgpt*
*.txt

graphify*

# Internal working notes, not part of the product.
#
# One folder rather than a growing list of root filenames — the old block
# ignored PRODUCT-AUDIT.md, BUGS.md, FUTURE_IMPLEMENTATIONS.md, SECURITY* and
# DESIGN* individually, which meant every new note either landed at the repo
# root or got committed by accident. See notes/README.md for what belongs in
# reference/ vs incidents/ vs followups/, and for the promotion rule.
#
# NOTE: notes/incidents/ can contain raw mailbox addresses and message
# metadata. It is ignored on purpose and must stay that way.
notes/*
docs/*
CLAUDE*