mailroid.in {
	# Refuse every protocol upgrade (WebSocket, h2c) before it reaches a
	# container. Nothing in production uses one — no WebSockets, no Server
	# Actions, no rewrites; Next's HMR socket is dev-only and never behind
	# Caddy — and Caddy forwards upgrades by default. That default is what made
	# the Next.js WebSocket-upgrade SSRF (CVE-2026-44578) reachable: a crafted
	# upgrade could make mailroid-web dial internal addresses (mailroid-api,
	# mailroid-alloy, the droplet metadata service). Next >= 16.2.5 fixes that
	# bug; this keeps the next one in the class from having a way in.
	# Must stay FIRST: handle blocks are first-match-wins. If a feature ever
	# needs a WebSocket, scope an exception to its exact path above this block.
	@upgrade header Upgrade *
	handle @upgrade {
		respond "Protocol upgrades are not supported" 400
	}
	# The HTTP/2 and HTTP/3 forms carry no Upgrade header: a WebSocket there is
	# an extended CONNECT (RFC 8441), and a tunnel is a plain CONNECT. Caddy
	# 2.11 forwards neither today (verified 2026-11-14: it answers CONNECT
	# itself and sends the upstream nothing), but that is Caddy's internals,
	# not our rule. Nothing legitimate sends CONNECT to this site.
	@connect method CONNECT
	handle @connect {
		respond "Protocol upgrades are not supported" 400
	}

	# apps/web has its own /api/* route handlers (Next.js route.ts files) that
	# must stay with the web container — these have to be matched before the
	# catch-all /api/* below, since Caddy's handle blocks are first-match-wins
	handle /api/chat {
		reverse_proxy mailroid-web:3000
	}
	handle /api/chat/seed {
		reverse_proxy mailroid-web:3000
	}
	handle /api/approvals/* {
		reverse_proxy mailroid-web:3000
	}
	handle /api/feedback {
		reverse_proxy mailroid-web:3000
	}
	handle /api/tools/* {
		reverse_proxy mailroid-web:3000
	}
	handle /api/usage {
		reverse_proxy mailroid-web:3000
	}
	handle /api/summarize {
		reverse_proxy mailroid-web:3000
	}
	handle /api/generate-email {
		reverse_proxy mailroid-web:3000
	}
	# Prefix block, not exact-match: the path carries an attachment id.
	handle /api/attachments/* {
		reverse_proxy mailroid-web:3000
	}
	# Sending with attachments. Lives in the web container because it takes
	# multipart/form-data, which tRPC cannot express, and because the API's
	# express.json() has no size limit. Exact-match is correct here — the path
	# carries no id.
	handle /api/compose/send {
		reverse_proxy mailroid-web:3000
	}
	handle /api/* {
		reverse_proxy mailroid-api:8000
	}
	handle /trpc/* {
		reverse_proxy mailroid-api:8000
	}
	handle /openapi.json {
		reverse_proxy mailroid-api:8000
	}
	handle /docs* {
		reverse_proxy mailroid-api:8000
	}
	handle {
		reverse_proxy mailroid-web:3000
	}
}
