# Dependencies
node_modules
**/node_modules

# Local env files. The `**/` forms are load-bearing: unlike .gitignore, a bare
# `.env` here matches ONLY the context root, so the per-package .env copies
# (packages/*/.env, apps/*/.env) would otherwise be copied in by `COPY . .` —
# and Next.js copies apps/web/.env into .next/standalone, which ships in the
# published image.
.env
**/.env
.env.local
**/.env.local
.env.*.local
**/.env.*.local
!.env.example
!**/.env.example

# Testing
coverage

# Turbo
.turbo
**/.turbo

# Build outputs
.next/
out/
build
dist
**/.next/
**/out/
**/build
**/dist

# Git
.git
.gitignore

# Docker
Dockerfile.*
.dockerignore

# CI/CD
.github

# Editor/OS
.vscode
.DS_Store

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dev.log

# Scratch / ad-hoc scripts, not part of the product
packages/services/scratch/

# Misc
*.zip
*.txt
graphify-out
PRODUCT-AUDIT.md
BUGS.md