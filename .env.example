# NOTE: values are intentionally unquoted — `docker run --env-file` does not
# strip surrounding quotes the way dotenv/dotenv-cli does, so quoting a value
# here would pass the literal quote characters into the container's env.

# DB
# Local dev (docker-compose.yml): postgresql://postgres:postgres@localhost:5432/mailroid_db
# Production (VPS, self-hosted via Docker): host must be the container name
# "mailroid-db" — the deploy pipeline starts Postgres on the shared
# mailroid-net Docker network and runs migrations against it automatically.
# POSTGRES_USER/PASSWORD/DB below must match the credentials in this URL.
DATABASE_URL=postgresql://postgres:postgres@mailroid-db:5432/mailroid_db

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mailroid_db

# Auth
#
# DUPLICATED ON PURPOSE, AND THE TRAP WORTH KNOWING: GOOGLE_CLIENT_ID,
# GOOGLE_CLIENT_SECRET and GMAIL_PUBSUB_TOPIC must carry the SAME values in
# `packages/corsair/.env` as they do here. `packages/corsair/scripts/setup.mjs`
# loads that file explicitly and ignores this one, so updating only the root
# .env leaves Corsair registered against the old client — silently, with no
# error anywhere, until an OAuth flow fails for reasons that make no sense.
#
# After changing them in both places: cd packages/corsair && pnpm corsair:setup
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

BETTER_AUTH_SECRET=your-better-auth-secret
BETTER_AUTH_URL=http://localhost:8000

CORSAIR_KEK=your-corsair-kek
CORSAIR_DEV_KEY=your-corsair-dev-key

CORSAIR_INSTANCE_ID=your-corsair-instance-id

# Ai - Deepseek
DEEPSEEK_API_KEY=your-openai-or-deepseek-api-key
DEEPSEEK_CHAT_MODEL=gpt-4o-mini
DEEPSEEK_BASE_URL=https://api.openai.com/v1
# DEEPSEEK_API_KEY=your-deepseek-api-key
# DEEPSEEK_CHAT_MODEL=deepseek-v4-pro
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Output-token ceiling for batch email classification. Only a cap — billing
# counts tokens actually generated, so headroom is free and just prevents a
# truncated JSON array from discarding a whole 50-email chunk. Must not exceed
# the model's own max output: gpt-4o-mini allows 16384, deepseek-chat 8192.
# Omit to fall back to the DeepSeek-safe default of 8192.
LLM_MAX_OUTPUT_TOKENS=16384



# Ai - OpenAI
EMBEDDINGS_API_KEY=your-openai-api-key
EMBEDDINGS_BASE_URL=https://api.openai.com/v1
EMBEDDINGS_MODEL=text-embedding-3-small


GMAIL_PUBSUB_TOPIC=projects/<your-gcp-project>/topics/<your-topic>

# The environment boundary (P-1 + P-11, docs/gmail-rate-limit-boundary.md
# §13). REQUIRED, no default — the app refuses to start without it. This is
# what stops a local dev box from connecting, watching or syncing a
# production mailbox (or the reverse): every Gmail mailbox belongs to exactly
# one Mailroid environment, and this pair of variables is that claim.
#
# MAILROID_ENV must be "local" or "production", and must match which one this
# process actually is — it is never inferred from NODE_ENV or the hostname.
#
# Ownership is then declared with EXACTLY ONE of the two list variables below
# — set neither and the app refuses to start, set both and it refuses too.
# Addresses are normalised (trim + lowercase) before comparison, same as
# LOG_HASH_SECRET's digests below, so casing in the list doesn't matter.
#
#   MAILROID_MAILBOX_ALLOWLIST — "I own ONLY these." The local model: a dev box
#   owns a few named test mailboxes and must never touch anything else. EMPTY
#   means it owns nothing and refuses everything, loudly — that is how you park
#   an environment, and it is why omission can never mean "allow all".
#
#   MAILROID_MAILBOX_DENYLIST — "I own everything EXCEPT these." The PRODUCTION
#   model, because real users sign up with addresses nobody can enumerate in
#   advance; an allowlist there would refuse every new customer. List exactly
#   the mailboxes another environment has claimed. Empty = owns every mailbox,
#   which is legal but must be typed out deliberately.
#
# The invariant worth keeping: prod's DENYLIST should mirror local's ALLOWLIST.
# A mailbox in both, or in neither, is the drift this boundary exists to catch.
MAILROID_ENV=local
MAILROID_MAILBOX_ALLOWLIST=

# In production (via Caddy path-based routing) BASE_URL and FRONTEND_URL are
# the same origin, e.g. https://mailroid.in for both
BASE_URL=https://your-ngrok-or-public-url
FRONTEND_URL=https://your-ngrok-or-public-url

# Shared secret /api/webhook requires as a ?token=... query param on every
# Gmail Pub/Sub and Calendar push. The app refuses to start without this set.
# Calendar watch registration appends it to the channel address automatically;
# the Gmail Pub/Sub push subscription's endpoint URL must be updated manually
# (gcloud pubsub subscriptions modify-push-config) to include it.
WEBHOOK_PUSH_TOKEN=a-long-random-string

# HYPHEN, not a slash. The routers mount at /api/auth/gmail-callback and
# /api/auth/calendar-callback (server.ts). These lines read ".../gmail/callback"
# until 2026-08-26 — a path that does not exist. It was harmless only because
# both variables are usually unset and the hyphenated fallback in gmail-oauth.ts
# applies; anyone who copied the example into a real .env broke OAuth.
#
# Whatever is set here must ALSO be registered as an authorised redirect URI on
# the OAuth client in Google Cloud, character for character.
GMAIL_OAUTH_CALLBACK_URL=https://your-ngrok-or-public-url/api/auth/gmail-callback
CALENDAR_OAUTH_CALLBACK_URL=https://your-ngrok-or-public-url/api/auth/calendar-callback

# Inngest (durable background jobs: email priority classification + the
# resumable full-mailbox Gmail sync). Without these, Inngest events are not
# delivered in production and those jobs silently don't run — the Gmail sync
# then falls back to a non-durable in-process sync at connect time.
# Get both keys from the Inngest dashboard (https://app.inngest.com) after
# registering your app's serve endpoint at {BASE_URL}/api/inngest.
INNGEST_EVENT_KEY=your-inngest-event-key
INNGEST_SIGNING_KEY=your-inngest-signing-key

# Web app
# In production this must be the plain API origin (no /api suffix) —
# better-auth's client appends /api/auth itself, and the tRPC client appends
# /trpc, which the API mounts at root — e.g. https://mailroid.in
NEXT_PUBLIC_API_URL=http://localhost:8000
# SKIP_ENV_VALIDATION=true

# NOTE: WHITELISTED_EMAILS is gone. Per-user entitlement now lives in the
# database — `subscription` for plans, `user.platform_role` for DEVELOPER
# authority — granted through billing.grantPlan rather than a redeploy.
# Environment variables hold configuration and secrets; who may do what, how
# much, and until when is not configuration.

# ── Logging ──────────────────────────────────────────────────────────
#
# SET THIS EXPLICITLY IN EVERY DEPLOYED ENVIRONMENT. It was set nowhere for a
# long time while the production default was "error", which silently discarded
# every logger.info in the codebase — webhook sync counts, quota-cooldown
# transitions, Gmail call attribution. The breadcrumbs were written and thrown
# away, which is worse than not writing them, because the code reads as if it
# is instrumented.
#
# The default is now "info" in production and "debug" in development.
# "debug" is per-message and genuinely noisy; turn it on for an incident, not
# as a standing setting.
LOGGER_LEVEL=info

# Where the file transport writes. Absolute paths are used as given; a relative
# path resolves against the WORKSPACE ROOT, never the current directory —
# CWD-relative resolution is what scattered one incident's logs across five
# different logs/ directories.
#
# Unset in development still writes <repo>/logs/app.log, because development
# restarts constantly (tsx watch) and loses the most. Unset in production means
# no file at all: stdout is the primary path there and Docker captures it, with
# rotation configured in .github/workflows/mailroid-deploy.yml.
# LOG_FILE=/var/log/mailroid/app.log

# Keys the mailbox digests that appear in logs where an address is genuinely the
# correlation key and no tenantId exists yet — a Pub/Sub push, mainly. Logs
# carry sha256(address + this)[0:12], never the address.
#
# Keyed rather than a plain hash because mailbox addresses are low-entropy and
# enumerable: an unkeyed sha256 of "someone@gmail.com" is a rainbow-table lookup
# away from being the address again.
#
# MUST BE STABLE FOR THE LIFETIME OF AN ENVIRONMENT. A value that changes across
# restarts produces a different digest for the same mailbox every time, which
# destroys the correlation the digest exists to provide — and this system
# restarts constantly under tsx watch. Any long random string; different values
# in dev and prod are fine and intended.
#
# Unset is safe: digests are disabled and logs say so once at startup. It never
# falls back to logging the address.
LOG_HASH_SECRET=change-me-to-a-long-random-string

# ── Telemetry (OTel → Alloy → Grafana Cloud) ─────────────────────────
#
# ENTIRELY OPT-IN. With OTEL_EXPORTER_OTLP_ENDPOINT unset the app opens no
# socket, loads no OTel SDK, and behaves exactly as it did before any of this
# existed. That is the default, and a complete dev environment.
#
# The address is the LOCAL collector, never the vendor. Alloy holds the Grafana
# credentials; the app only ever knows "send to my collector". That boundary is
# what lets the vendor change without touching application code.
#
#   dev  — Alloy publishes 4318 to the host (see docker-compose.yml), because
#          `pnpm dev` runs the API on the host rather than in the compose network
#   prod — every container is on mailroid-net, so it is the container name
#
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318          # dev
# OTEL_EXPORTER_OTLP_ENDPOINT=http://mailroid-alloy:4318     # prod

# REQUIRED WHENEVER THE ENDPOINT IS SET, AND NEVER DEFAULTED. The app refuses to
# start without them rather than guessing — dev and prod telemetry landing in one
# Grafana stack with no distinguishing label is the same class of mistake as
# un-prefixed cache keys, and you find out mid-incident.
#
# OTEL_SERVICE_NAME below is the DEV value only. In prod, api and web share
# this one file but must not share a service name — mailroid-deploy.yml
# forces the correct one per container with `docker run -e`, which always
# wins over --env-file, so this line is irrelevant to prod and dev-only here.
#
# OTEL_SERVICE_NAME=mailroid-api        # dev runs the API on the host; set to mailroid-web to watch the web app instead
# DEPLOYMENT_ENVIRONMENT=dev            # prod on the VPS

# Alloy ONLY — never read by the application, and it must stay that way.
# From the Grafana Cloud "OTLP" connection page. The deploy workflow skips the
# Alloy container entirely when GRAFANA_CLOUD_OTLP_ENDPOINT is unset.
# GRAFANA_CLOUD_OTLP_ENDPOINT=https://otlp-gateway-<region>.grafana.net/otlp
# GRAFANA_CLOUD_INSTANCE_ID=
# GRAFANA_CLOUD_API_TOKEN=
